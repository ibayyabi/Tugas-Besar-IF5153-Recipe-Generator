{
  "version": "1.0.0",
  "description": "Hand-annotated Pipeline 1 test set. Each query pairs a natural-language pantry request with the structured query the extractor must produce. Ingredient strings are canonical (lowercase, singular) forms from data/processed/calorie_baseline.csv unless the surface form itself is canonical.",
  "labeling_rules": {
    "available_ingredients": "Surface forms are normalized to the canonical ingredient (lemma + alias). Ingredient mentions inside an exclusion clause never appear here.",
    "excluded_ingredients": "One entry per excluded ingredient. 'no X or Y' yields two entries.",
    "calorie_target": "Used for approximate targets: around, about, approximately, roughly.",
    "calorie_max": "Used for upper bounds: under, below, max, maximum, less than, up to, no more than.",
    "calorie_min": "Used for lower bounds and ranges: at least, minimum, over, between A and B.",
    "unset": "null when the constraint is absent."
  },
